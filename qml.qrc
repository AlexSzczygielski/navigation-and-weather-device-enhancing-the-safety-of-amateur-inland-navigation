<RCC>
    <qresource prefix="/">
        <!-- QML CONF -->
        <file>qtquickcontrols2.conf</file>

        <!-- QML Views -->
        <file>main.qml</file>
        <file>views/home.qml</file>
        <file>views/cv_create_roi_panel.qml</file>
        <file>views/cv_detect_pipe_panel.qml</file>
        <file>views/gps_data_panel.qml</file>

        <!-- QML Components -->
        <file>components/IconButton.qml</file>
        <file>components/StatusIndicator.qml</file>
        <file>components/DataRow.qml</file>
        

        <!-- Assets Icons -->
        <file>assets/home.svg</file>
        <file>assets/navi.svg</file>
        <file>assets/settings.svg</file>
        <file>assets/camera100.svg</file>
        <file>assets/off.svg</file>
        <file>assets/weather.svg</file>
        <file>assets/day.svg</file>
        <file>assets/night.svg</file>
        <file>assets/mob_system.svg</file>

        <!-- Assets Pictures -->
        <file>assets/model.png</file>
        <file>assets/empty_map.png</file>
    </qresource>
</RCC>